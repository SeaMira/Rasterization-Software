#version 460

// ==============================================================================
// Cylinder Rasterization Shader (Indirect Dispatch Version)
// ==============================================================================
// Este shader procesa únicamente los cilindros que pasaron el frustum culling.
// Lee los índices del buffer de cilindros visibles y realiza la rasterización.
// Se ejecuta mediante Indirect Dispatch basado en el número de cilindros visibles.
// ==============================================================================

layout(local_size_x = 256) in;
layout(rgba8, binding = 0) uniform image2D outputImage;

layout(std430, binding = 3) buffer DepthBuffer 
{
    uint depthBuffer[];
};

struct CylinderIndex
{
    uint sphereIndexA;
    uint sphereIndexB;
    float radius;
    uint _padding;
};

layout(std430, binding = 6) buffer SphereBuffer
{
    vec4 spheres[];
};

// Todos los cilindros
layout(std430, binding = 7) buffer CylinderBuffer 
{
    CylinderIndex cylinderIndices[];
};

// Índices de cilindros visibles (del frustum culling)
layout(std430, binding = 13) buffer VisibleCylinderIndices 
{
    uint visibleCylinderIndices[];
};

// Contador de cilindros visibles
layout(std430, binding = 14) buffer VisibleCylinderCount 
{
    uint visibleCylinderCount;
};

uniform mat4 view;
uniform mat4 proj;

uniform vec3 front;
uniform vec3 up;
uniform vec3 right;
uniform vec3 cameraPos;

uniform ivec2 screenResolution;
uniform float fov;

const vec3 lightColor = vec3(0.01, 1.0, 0.05);
const float diffuseI = 0.9;

// ============================================================================
// Ray Casting Structures
// ============================================================================

struct ScreenRayCasting
{
    vec3 rayStart;
    vec3 dx;
    vec3 dy;
};

ScreenRayCasting makeScreenRayCasting(float aspectRatio)
{
    float fovRad = radians(fov);
    float fovTan = tan(fovRad * 0.5f);
    float halfFovTan = fovTan * aspectRatio;

    vec3 corner00 = normalize((-1.0f * halfFovTan) * right + (-1.0f * fovTan) * up + front);
    vec3 corner10 = normalize(( 1.0f * halfFovTan) * right + (-1.0f * fovTan) * up + front);
    vec3 corner01 = normalize((-1.0f * halfFovTan) * right + ( 1.0f * fovTan) * up + front);

    vec3 wCorner00 = mat3(view) * corner00;
    vec3 wCorner10 = mat3(view) * corner10;
    vec3 wCorner01 = mat3(view) * corner01;

    vec3 dx = (wCorner10 - wCorner00) / float(screenResolution.x);
    vec3 dy = (wCorner01 - wCorner00) / float(screenResolution.y);

    return ScreenRayCasting(wCorner00, dx, dy);
}

// ============================================================================
// Cylinder Intersection
// ============================================================================

vec4 iCylinder(vec3 ro, vec3 rd, vec3 pa, vec3 pb, float ra) 
{
    vec3 ba = pb - pa;
    vec3 oc = ro - pa;

    float baba = dot(ba, ba);
    float bard = dot(ba, rd);
    float baoc = dot(ba, oc);
    
    float k2 = baba - bard * bard;
    float k1 = baba * dot(oc, rd) - baoc * bard;
    float k0 = baba * dot(oc, oc) - baoc * baoc - ra * ra * baba;
    
    float h = k1 * k1 - k2 * k0;
    if (h < 0.0f) return vec4(-1.0f);
    h = sqrt(h);
    float t = (-k1 - h) / k2;

    // body
    float y = baoc + t * bard;
    if (y > 0.0f && y < baba) return vec4(t, oc + t * rd - ba * y / baba);

    return vec4(-1.0f);
}

// ============================================================================
// Bounding Box Calculation
// ============================================================================

void getCylinderBbox(out vec2 projectedPoints[4], vec3 pa, vec3 pb, vec3 center, float cylRadius)
{
    const vec3 z = normalize(pb - pa);

    vec3 x = normalize(cross(center, z));
    vec3 y = normalize(cross(x, z));

    const float dV0 = length(pa);
    const float dV1 = length(pb);

    const float sinAngle = cylRadius / dV0;
    float angle = asin(sinAngle);
    const vec3 y1 = y * cylRadius;
    const vec3 x2 = x * cylRadius * cos(angle);
    const vec3 y2 = y1 * sinAngle;
    angle = asin(cylRadius / dV1);
    const vec3 x3 = x * (dV1 - cylRadius) * tan(angle);

    const vec3 v1 = pa - x2 + y2;
    const vec3 v2 = pa + x2 + y2;
    const vec3 v3 = pb - x3 + y1;
    const vec3 v4 = pb + x3 + y1;

    const vec4 v1Proj = proj * vec4(v1, 1.0f);
    const vec4 v2Proj = proj * vec4(v2, 1.0f);
    const vec4 v3Proj = proj * vec4(v3, 1.0f);
    const vec4 v4Proj = proj * vec4(v4, 1.0f);

    vec3 ndcv1Proj = vec3(v1Proj.x / v1Proj.w, v1Proj.y / v1Proj.w, v1Proj.z / v1Proj.w);
    vec3 ndcv2Proj = vec3(v2Proj.x / v2Proj.w, v2Proj.y / v2Proj.w, v2Proj.z / v2Proj.w);
    vec3 ndcv3Proj = vec3(v3Proj.x / v3Proj.w, v3Proj.y / v3Proj.w, v3Proj.z / v3Proj.w);
    vec3 ndcv4Proj = vec3(v4Proj.x / v4Proj.w, v4Proj.y / v4Proj.w, v4Proj.z / v4Proj.w);

    projectedPoints[0] = vec2(ndcv1Proj);
    projectedPoints[1] = vec2(ndcv2Proj);
    projectedPoints[2] = vec2(ndcv4Proj);
    projectedPoints[3] = vec2(ndcv3Proj);
}

vec3 computeRd(int px, int py, float fovTan, float halfFovTan)
{
    vec2 p = (-vec2(screenResolution.x, screenResolution.y) + 2.0f * vec2(px, py)) / vec2(screenResolution.x, screenResolution.y);
    return normalize(p.x * right * halfFovTan + p.y * up * fovTan + front);
}

float intersectX(vec2 a, vec2 b, float y) 
{
    if (a.y == b.y) return a.x;
    float t = (y - a.y) / (b.y - a.y);
    return a.x + t * (b.x - a.x);
}

// ============================================================================
// Cylinder Drawing
// ============================================================================

void drawCylinder(vec3 pa, vec3 pb, float ra, uint cylinderIndex)
{
    vec3 camSpaceCylA = vec3(view * vec4(pa, 1.0f));
    vec3 camSpaceCylB = vec3(view * vec4(pb, 1.0f));

    vec3 camImpPosA, camImpPosB;
    if (camSpaceCylA.z < camSpaceCylB.z)
    {
        camImpPosA = camSpaceCylB;
        camImpPosB = camSpaceCylA;
    }
    else
    {
        camImpPosA = camSpaceCylA;
        camImpPosB = camSpaceCylB;
    }

    vec3 center = normalize((camImpPosA + camImpPosB) * 0.5f);
    vec2 projectedPoints[4];
    getCylinderBbox(projectedPoints, camImpPosA, camImpPosB, center, ra);
    
    float aspectRatio = float(screenResolution.x) / float(screenResolution.y);
    
    int minY = screenResolution.y;
    int maxY = 0;
    for (int i = 0; i < 4; i++) 
    {
        projectedPoints[i].x = int((projectedPoints[i].x * 0.5f + 0.5f) * screenResolution.x);
        projectedPoints[i].y = int((projectedPoints[i].y * 0.5f + 0.5f) * screenResolution.y);

        minY = min(minY, int(floor(projectedPoints[i].y))); 
        maxY = max(maxY, int(ceil(projectedPoints[i].y)));
    }

    float fovRad = radians(fov);
    float fovTan = tan(fovRad * 0.5f);
    float halfFovTan = fovTan * aspectRatio;

    ScreenRayCasting screenRayCasting = makeScreenRayCasting(aspectRatio);

    vec3 dx = screenRayCasting.dx;
    vec3 dy = screenRayCasting.dy;
    vec3 rayStart = screenRayCasting.rayStart;
    
    for (int py = min(screenResolution.y - 1, maxY); py >= max(0, minY); --py)
    {
        float xIntersections[4];
        int intersections = 0;

        for (int i = 0; i < 4; ++i) 
        {
            const vec2 a = projectedPoints[i];
            const vec2 b = projectedPoints[(i + 1) % 4];

            if ((py >= a.y && py <= b.y) || (py >= b.y && py <= a.y)) 
            {
                float x = intersectX(a, b, py);
                xIntersections[intersections] = x;
                intersections++;
            }
        }

        if (intersections >= 2)
        {
            float xMin = xIntersections[0];
            float xMax = xIntersections[0];
            for (int i = 1; i < intersections; ++i) 
            {
                xMin = min(xMin, xIntersections[i]);
                xMax = max(xMax, xIntersections[i]);
            }

            vec3 rayColStart = rayStart + float(py) * dy;
            for (int px = max(0, int(ceil(xMin))); px <= min(int(floor(xMax)), screenResolution.x - 1); ++px) 
            {
                vec2 p = (-vec2(screenResolution.x, screenResolution.y) + 2.0f * vec2(px, py)) / vec2(screenResolution.x, screenResolution.y);

                vec3 rd = normalize(p.x * right * halfFovTan + p.y * up * fovTan + front);

                vec4 tnor = iCylinder(cameraPos, rd, pa, pb, ra);
                int index = px + screenResolution.x * py;
                
                if (tnor.x > 0.0f) 
                {
                    float t = tnor.x;
                    const vec3 hit = (rayColStart + float(px) * dx) * t;
                    const float depth = (hit.z * proj[2].z + proj[3].z) / -hit.z;
                    const uint depthUint = floatBitsToUint(depth);
                    uint old = atomicMin(depthBuffer[index], depthUint);
                    if (uintBitsToFloat(old) > depth)
                    {
                        vec3 normal = normalize(vec3(tnor.y, tnor.z, tnor.w));
                        const float lambertCos = dot(normal, -normalize(t * rd));
                        imageStore(outputImage, ivec2(px, py), vec4(lambertCos * lightColor * diffuseI, 1.0));
                    }
                }
            }
        }
    }
}

// ============================================================================
// Main
// ============================================================================

void main() 
{
    uint visibleIndex = gl_GlobalInvocationID.x;

    // Check if the index is out of bounds
    if (visibleIndex >= visibleCylinderCount) {
        return;
    }

    // Get the original cylinder index from the visible indices buffer
    uint originalIndex = visibleCylinderIndices[visibleIndex];
    
    // Get and draw the cylinder
    CylinderIndex c = cylinderIndices[originalIndex];
    vec3 pa = spheres[c.sphereIndexA].xyz;
    vec3 pb = spheres[c.sphereIndexB].xyz;
    float ra = c.radius;
    drawCylinder(pa, pb, ra, originalIndex);
}
