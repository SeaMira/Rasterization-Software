#version 460

// =============================================================================
// small_cylinder_raster.compute - Direct Rasterization for Small Cylinders
// =============================================================================
//
// This shader rasterizes "small" cylinders using the 1st version approach:
// - One thread per cylinder
// - Each thread iterates over all pixels in its bbox
// - Efficient for small entities (low pixel count)
//
// Dispatch: (smallCylinderCount / 256, 1, 1)
// =============================================================================

layout(local_size_x = 256) in;

// -----------------------------------------------------------------------------
// Output Bindings
// -----------------------------------------------------------------------------

layout(rgba8, binding = 0) uniform image2D outputImage;

layout(std430, binding = 1) buffer DepthBuffer {
    uint depthBuffer[];
};

// -----------------------------------------------------------------------------
// Input Bindings
// -----------------------------------------------------------------------------

struct Cylinder {
    vec4 pa_r;
    vec4 pb_r;
};

layout(std430, binding = 7) buffer CylinderBuffer {
    Cylinder cylinders[];
};

layout(std430, binding = 11) buffer SmallCylinderCounter {
    uint smallCylinderCount;
};

layout(std430, binding = 13) buffer SmallCylinderIndices {
    uint smallCylinderIndices[];
};

// -----------------------------------------------------------------------------
// Uniforms
// -----------------------------------------------------------------------------

uniform mat4 view;
uniform mat4 proj;

uniform vec3 front;
uniform vec3 up;
uniform vec3 right;
uniform vec3 cameraPos;

uniform ivec2 screenResolution;
uniform float fov;

// -----------------------------------------------------------------------------
// Constants
// -----------------------------------------------------------------------------

const vec3 lightColor = vec3(0.01, 1.0, 0.05);
const float diffuseI = 0.9;

// -----------------------------------------------------------------------------
// BBox Computation
// -----------------------------------------------------------------------------

void computeCylinderBBox(vec3 pa, vec3 pb, float radius, out ivec2 screenMin, out ivec2 screenMax) {
    vec3 camA = vec3(view * vec4(pa, 1.0));
    vec3 camB = vec3(view * vec4(pb, 1.0));
    
    vec3 axis = camB - camA;
    float axisLenSq = dot(axis, axis);
    vec3 e = radius * sqrt(max(vec3(0.001), vec3(1.0) - axis * axis / axisLenSq));
    
    vec3 corners[4];
    corners[0] = camA + e;
    corners[1] = camA - e;
    corners[2] = camB + e;
    corners[3] = camB - e;
    
    vec2 minC = vec2(1e6);
    vec2 maxC = vec2(-1e6);
    
    for (int i = 0; i < 4; i++) {
        vec4 clip = proj * vec4(corners[i], 1.0);
        if (clip.w > 0.001) {
            vec2 ndc = clip.xy / clip.w;
            minC = min(minC, ndc);
            maxC = max(maxC, ndc);
        }
    }
    
    screenMin.x = int(floor((minC.x * 0.5 + 0.5) * float(screenResolution.x)));
    screenMin.y = int(floor((minC.y * 0.5 + 0.5) * float(screenResolution.y)));
    screenMax.x = int(ceil((maxC.x * 0.5 + 0.5) * float(screenResolution.x)));
    screenMax.y = int(ceil((maxC.y * 0.5 + 0.5) * float(screenResolution.y)));
    
    screenMin = max(screenMin, ivec2(0));
    screenMax = min(screenMax, screenResolution);
}

// -----------------------------------------------------------------------------
// Ray-Cylinder Intersection
// -----------------------------------------------------------------------------

vec2 iCylinder(vec3 ro, vec3 rd, vec3 pa, vec3 pb, float ra) {
    vec3 ba = pb - pa;
    vec3 oc = ro - pa;
    
    float baba = dot(ba, ba);
    float bard = dot(ba, rd);
    float baoc = dot(ba, oc);
    
    float k2 = baba - bard * bard;
    float k1 = baba * dot(oc, rd) - baoc * bard;
    float k0 = baba * dot(oc, oc) - baoc * baoc - ra * ra * baba;
    
    float h = k1 * k1 - k2 * k0;
    if (h < 0.0) return vec2(-1.0);
    
    h = sqrt(h);
    float t = (-k1 - h) / k2;
    
    float y = baoc + t * bard;
    if (y > 0.0 && y < baba) {
        return vec2(t, y / baba);
    }
    
    t = ((y < 0.0 ? 0.0 : baba) - baoc) / bard;
    if (abs(k1 + k2 * t) < h) {
        return vec2(t, y < 0.0 ? 0.0 : 1.0);
    }
    
    return vec2(-1.0);
}

// -----------------------------------------------------------------------------
// Ray Direction
// -----------------------------------------------------------------------------

vec3 computeRd(int px, int py, float fovTan, float halfFovTan) {
    vec2 p = (-vec2(screenResolution) + 2.0 * vec2(px, py)) / vec2(screenResolution);
    return normalize(p.x * right * halfFovTan + p.y * up * fovTan + front);
}

// -----------------------------------------------------------------------------
// Main
// -----------------------------------------------------------------------------

void main() {
    uint workIndex = gl_GlobalInvocationID.x;
    
    if (workIndex >= smallCylinderCount) {
        return;
    }
    
    uint cylIndex = smallCylinderIndices[workIndex];
    Cylinder cyl = cylinders[cylIndex];
    vec3 pa = cyl.pa_r.xyz;
    vec3 pb = cyl.pb_r.xyz;
    float radius = cyl.pa_r.w;
    
    // Recompute bbox
    ivec2 screenMin, screenMax;
    computeCylinderBBox(pa, pb, radius, screenMin, screenMax);
    
    float aspectRatio = float(screenResolution.x) / float(screenResolution.y);
    float fovRad = radians(fov);
    float fovTan = tan(fovRad * 0.5);
    float halfFovTan = fovTan * aspectRatio;
    
    for (int py = screenMin.y; py < screenMax.y; py++) {
        for (int px = screenMin.x; px < screenMax.x; px++) {
            vec3 rd = computeRd(px, py, fovTan, halfFovTan);
            vec2 result = iCylinder(cameraPos, rd, pa, pb, radius);
            
            if (result.x > 0.0) {
                vec3 hit = cameraPos + rd * result.x;
                vec4 hitClip = proj * view * vec4(hit, 1.0);
                float depth = hitClip.z / hitClip.w;
                
                uint depthU = floatBitsToUint(depth);
                int pixelIndex = py * screenResolution.x + px;
                
                uint oldDepth = atomicMin(depthBuffer[pixelIndex], depthU);
                
                if (uintBitsToFloat(oldDepth) > depth) {
                    vec3 ba = pb - pa;
                    vec3 hitLocal = hit - pa;
                    float h = dot(hitLocal, ba) / dot(ba, ba);
                    vec3 normal;
                    if (h > 0.0 && h < 1.0) {
                        normal = normalize(hitLocal - ba * h);
                    } else {
                        normal = normalize(hitLocal - ba * clamp(h, 0.0, 1.0));
                    }
                    
                    float lambert = max(0.0, dot(normal, -normalize(rd)));
                    vec3 color = lightColor * lambert * diffuseI;
                    
                    imageStore(outputImage, ivec2(px, py), vec4(color, 1.0));
                }
            }
        }
    }
}
